<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Clears the repository-wide default so the multi-target list below takes effect. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <AssemblyName>KeelMatrix.MetricBudget</AssemblyName>
    <RootNamespace>KeelMatrix.MetricBudget</RootNamespace>

    <Version>0.1.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <PackageId>KeelMatrix.MetricBudget</PackageId>
    <Description>Verify observed metric cardinality in .NET tests and CI. Observe the metric series and tag values the exercised workload actually emits, and fail when an instrument exceeds an explicit observed-series or per-tag distinct-value budget.</Description>
    <PackageTags>metrics;cardinality;opentelemetry;system-diagnostics-metrics;testing;ci;observability</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/KeelMatrix/MetricBudget#readme</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- API drift is a compatibility decision for a shipping library. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KeelMatrix.Telemetry" />
  </ItemGroup>

  <!--
    netstandard2.0 has no in-box metrics API, so the shared metrics abstraction comes from the package.
    net8.0 uses the framework-provided implementation and must not restore a package asset for it.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Update="System.Diagnostics.DiagnosticSource" ExcludeAssets="all" />
  </ItemGroup>
</Project>
