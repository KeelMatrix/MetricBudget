root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

[*.md]
trim_trailing_whitespace = false

; ProbeTagCanonicalizer.cs and ProbeSeriesTracker.cs are compiled for net8.0 and netstandard2.0, so they cannot
; use the net8.0-only argument-validation throw helpers that CA1510/CA1512 suggest.
[**/ProbeTagCanonicalizer.cs]
dotnet_diagnostic.CA1510.severity = none
dotnet_diagnostic.CA1512.severity = none

[**/ProbeSeriesTracker.cs]
dotnet_diagnostic.CA1510.severity = none
dotnet_diagnostic.CA1512.severity = none

; The shipping library targets netstandard2.0 as well, where the net8.0-only argument-validation throw helpers
; (CA1510/CA1512/CA1513) do not exist, so explicit argument validation is the only option in shared sources.
[src/KeelMatrix.MetricBudget/**.cs]
dotnet_diagnostic.CA1510.severity = none
dotnet_diagnostic.CA1512.severity = none
dotnet_diagnostic.CA1513.severity = none
